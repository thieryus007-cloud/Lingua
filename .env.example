# Unsplash API Configuration (Required - for real photos)
# Get your access key from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Gemini API Configuration (Required - for word generation)
# Get your API key from: https://aistudio.google.com/app/apikey
API_KEY=your_gemini_api_key_here

# Optional: Claude API (if you want to use Claude instead of Gemini)
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# Optional: Pexels API (Alternative photo source)
# Get your API key from: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here
